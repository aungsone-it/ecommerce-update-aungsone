# Copy to `.env` for local dev. Vite only exposes variables prefixed with `VITE_`.
# For production, set the same keys in your host’s dashboard (Vercel, Netlify, etc.).

# --- Supabase (IMPORTANT) ---
# Most API and Auth calls use utils/supabase/info.tsx (projectId + publicAnonKey),
# NOT VITE_SUPABASE_* below. Update info.tsx when pointing at a different Supabase project.
#
# Optional overrides (rare):
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_key
# (Only StripePayment.tsx reads these today — main app uses info.tsx)

# Optional: override default Supabase image transform width (grid default 480px, logo 128px, banner 960px).
# Requires a Supabase plan with Storage image transformations enabled.
# VITE_SUPABASE_THUMB_MAX=480

# --- Vendor subdomains (optional) ---
# Apex domain only, no protocol: `example.com`
# Required for multi-part public suffixes (e.g. .co.uk) where auto-detection is wrong.
# VITE_VENDOR_SUBDOMAIN_BASE_DOMAIN=example.com

# JSON map: short DNS label → real store slug in /vendor/:slug
# Example: {"gogo":"go-go","myshop":"my-shop"}
# VITE_VENDOR_SUBDOMAIN_SLUG_MAP={}

# Optional local subdomain checkout (e.g. http://gogo.localhost:5173/checkout → /summary):
# VITE_VENDOR_SUBDOMAIN_BASE_DOMAIN=localhost

# --- Admin destructive operations (optional) ---
# Must match Supabase secret EDGE_ADMIN_OPERATION_SECRET on the server.
# VITE_ADMIN_OPERATION_SECRET=

# --- Payments (optional / not in live vendor checkout) ---
# VITE_STRIPE_PUBLISHABLE_KEY=

# Vercel Edge middleware (server env, not VITE_ — set in Vercel project settings):
# VENDOR_SUBDOMAIN_BASE_DOMAIN=example.com
# VENDOR_SUBDOMAIN_SLUG_MAP={"gogo":"go-go"}

# Supabase Edge Function secrets (set in Supabase dashboard, not in .env):
# KBZPay gateway credentials, EDGE_ADMIN_OPERATION_SECRET, STRIPE_SECRET_KEY (optional)
